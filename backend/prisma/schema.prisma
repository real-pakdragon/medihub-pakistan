generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceCategory {
  pre_clinical
  clinical
  past_papers
  video
  community
  textbook
}

enum Section {
  mbbs
  mdcat
}

enum ContentType {
  book
  pdf
  ppt
  link
  video
  file
  image
}

model Category {
  id           String     @id @default(cuid())
  section      Section    @default(mbbs)
  name         String
  slug         String     @unique
  description  String?
  iconName     String?    @map("icon_name")
  parentId     String?    @map("parent_id")
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[] @relation("CategoryTree")
  displayOrder Int        @default(0) @map("display_order")
  isPublished  Boolean    @default(true) @map("is_published")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  items ContentItem[]
  posts Post[]

  @@index([section, parentId])
  @@index([parentId])
  @@index([displayOrder])
  @@map("categories")
}

model Post {
  id          String   @id @default(cuid())
  section     Section  @default(mbbs)
  title       String
  categoryId  String   @map("category_id")
  body        String   @db.Text
  isPublished Boolean  @default(true) @map("is_published")
  displayOrder Int     @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([section, categoryId])
  @@index([categoryId])
  @@index([isPublished, createdAt])
  @@map("posts")
}

model ContentItem {
  id          String      @id @default(cuid())
  section     Section     @default(mbbs)
  title       String
  type        ContentType
  categoryId  String      @map("category_id")
  description String?
  author      String?
  edition     String?
  fileName    String?     @map("file_name")
  filePath    String?     @map("file_path")
  url         String?
  fileSize    Int?        @map("file_size")
  isPublished Boolean     @default(true) @map("is_published")
  displayOrder Int        @default(0) @map("display_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([section, categoryId])
  @@index([categoryId])
  @@index([isPublished, createdAt])
  @@map("content_items")
}

enum MessageStatus {
  new
  read
  replied
}

model Resource {
  id          String           @id @default(cuid())
  title       String
  category    ResourceCategory
  yearTag     String?          @map("year_tag")
  iconName    String?          @map("icon_name")
  description String?
  links       Json             @default("[]")
  isPublished Boolean          @default(false) @map("is_published")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([category])
  @@index([isPublished, createdAt])
  @@map("resources")
}

model Subject {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  iconName     String?  @map("icon_name")
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  books Book[]

  @@map("subjects")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  subjectId   String   @map("subject_id")
  author      String?
  edition     String?
  description String?
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([isPublished, createdAt])
  @@map("books")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    MessageStatus @default(new)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}

model Subscriber {
  id                String   @id @default(cuid())
  email             String   @unique
  subscribedAt      DateTime @default(now()) @map("subscribed_at")
  confirmed         Boolean  @default(false)
  confirmationToken String   @unique @map("confirmation_token")

  @@map("subscribers")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model PracticeQuestion {
  id           String   @id @default(cuid())
  university   String
  yearTag      String
  subject      String
  statement    String
  options      Json
  correctIndex Int
  explanation  String?
  createdAt    DateTime @default(now())

  @@index([university, yearTag, subject])
}

model MdcatConfig {
  id               Int      @id @default(1)
  launchDate       DateTime @map("launch_date")
  currentPhase     String   @default("Registration") @map("current_phase")
  phaseDescription String   @default("") @map("phase_description")

  @@map("mdcat_config")
}
