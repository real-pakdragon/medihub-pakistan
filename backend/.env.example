# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medihub?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
SEED_ADMIN_EMAIL=admin@medihub.pk
SEED_ADMIN_PASSWORD=ChangeMe!2024

# ---- CORS / URLs ----
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
WEB_APP_URL=http://localhost:5173
# Public base URL of this API (used to build confirmation links in emails)
API_URL=http://localhost:5000

# ---- Email (SMTP via Resend or SendGrid) ----
# Resend SMTP: host smtp.resend.com, user "resend", pass = your API key
# SendGrid SMTP: host smtp.sendgrid.net, user "apikey", pass = your API key
MAIL_FROM="MediHub Pakistan <no-reply@medihub.pk>"
ADMIN_NOTIFY_EMAIL=admin@medihub.pk
CONTACT_AUTOREPLY=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Home page stats ----
# Displayed as "students connected" baseline so the counter looks alive on a fresh install
STUDENTS_BASELINE=12400
